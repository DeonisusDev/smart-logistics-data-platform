<!-- Connection to the PostgreSQL DWH for postgresql() table functions. Credentials come from the
     container environment, so they never appear in SQL text or query_log. -->
<clickhouse>
    <named_collections>
        <pg_dwh>
            <host from_env="PG_HOST"/>
            <port from_env="PG_PORT"/>
            <database from_env="PG_DATABASE"/>
            <user from_env="PG_USER"/>
            <password from_env="PG_PASSWORD"/>
        </pg_dwh>
    </named_collections>
</clickhouse>
