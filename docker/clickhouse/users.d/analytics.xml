<!-- Application user. The password is taken from CH_ANALYTICS_PASSWORD; the default user is limited to localhost. -->
<clickhouse>
    <users>
        <analytics>
            <password from_env="CH_ANALYTICS_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </analytics>
        <default>
            <networks replace="replace"><ip>::1</ip><ip>127.0.0.1</ip></networks>
        </default>
    </users>
</clickhouse>
