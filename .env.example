# Copy to .env to override defaults (docker-compose reads .env automatically).
# All values below are local-demo defaults - change the passwords and secret keys for anything shared.

# --- PostgreSQL 17 (source + DWH + Airflow/Superset metadata)
POSTGRES_DB=deals_bigdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Inside docker-compose DB_DSN is assembled from POSTGRES_* above.
# For running Python on the host (venv), export it with localhost:
# DB_DSN=postgresql://postgres:postgres@localhost:5432/deals_bigdata

# --- Pipeline
# Snapshot date ("now" of the task) and ETL window by loading_date, inclusive.
# Empty window = whole source (incl. planned loadings after AS_OF, which are needed for scoring).
AS_OF=2026-10-26
START_DATE=
END_DATE=
RANDOM_SEED=42
# catboost | hist_gradient_boosting | ridge
MODEL_NAME=catboost
# text | json
LOG_FORMAT=text

# --- ClickHouse (bonus): user "analytics"
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_HTTP_PORT=8123

# --- Airflow (bonus): UI http://localhost:8080
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-airflow
# Optional Fernet key for encrypted connections:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Superset (bonus): UI http://localhost:8088
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=change-me-superset-secret-key
